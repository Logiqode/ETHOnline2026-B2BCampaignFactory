# Wizard backend local dev — copy to .env and adjust if needed (gitignored).
# The backend reads DATABASE_URL; compose defaults match these.

# Postgres connection (Dockerized on 5433; see docker-compose.yml)
DATABASE_URL=postgresql://wizard:wizard@localhost:5433/wizard

# Port the backend listens on
PORT=4000

# Allowed browser origin (Vite dev server). Change if Vite runs on another port.
CORS_ORIGIN=http://localhost:5173